{
  "name": "bookhaven",
  "version": "1.0.2",
  "description": "A local, browser-based EPUB reader with bookmarks, highlights, and reading themes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arun2565/BookHaven.git"
  },
  "main": "desktop/main.cjs",
  "license": "MIT",
  "keywords": [
    "epub",
    "ebook-reader",
    "reader",
    "books",
    "cli"
  ],
  "type": "module",
  "bin": {
    "bookhaven": "bin/bookhaven.js",
    "BookHaven": "bin/bookhaven.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev",
    "desktop:build": "npm run build && electron-builder --win nsis --publish never",
    "postinstall": "patch-package",
    "prepack": "npm run build",
    "test": "npm run build"
  },
  "build": {
    "appId": "com.bookhaven.desktop",
    "productName": "BookHaven",
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "patch-package": "^8.0.1",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
